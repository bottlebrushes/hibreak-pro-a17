// HiBreak e-ink companion applications.
android_app {
    name: "EinkShade",
    srcs: ["shade-src/src/**/*.java"],
    resource_dirs: ["shade-src/res"],
    manifest: "shade-src/AndroidManifest.xml",
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    target_sdk_version: "35",
    dex_preopt: { enabled: false },
    required: ["EinkShadePrivappPermissions"],
}

prebuilt_etc {
    name: "EinkShadeDefaultPermissions",
    src: "default-permissions-local.eink.shade.xml",
    filename: "default-permissions-local.eink.shade.xml",
    sub_dir: "default-permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "EinkShadePrivappPermissions",
    src: "privapp-permissions-local.eink.shade.xml",
    filename: "privapp-permissions-local.eink.shade.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
android_app_import {
    name: "LoopHabitTrackerBw",
    apk: "prebuilt/loop-bw.apk",
    product_specific: true,
    // Prebuilts are unsigned build outputs: the build signs them with the default key.
    certificate: "testkey",
    dex_preopt: { enabled: false },
}
