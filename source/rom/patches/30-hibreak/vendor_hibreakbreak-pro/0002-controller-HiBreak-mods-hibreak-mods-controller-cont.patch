diff --git a/controller/a9_accessibility_service/res/values/themes.xml b/controller/a9_accessibility_service/res/values/themes.xml
index f51dba6..2587619 100644
--- a/controller/a9_accessibility_service/res/values/themes.xml
+++ b/controller/a9_accessibility_service/res/values/themes.xml
@@ -14,6 +14,92 @@
         <item name="android:textColorSecondary">#333333</item>
     </style>
 
+    <!-- Settings screen in the Hisense e-ink layout: plain title bar over a black rule, full-width rows with grey
+         summaries, black section labels, pill switches, outlined pop-ups. No dimming, shadows or focus greys. -->
+    <style name="Theme.Ha9_comp_service.Settings">
+        <item name="actionBarStyle">@style/HsActionBar</item>
+        <item name="android:actionBarStyle">@style/HsActionBar</item>
+        <item name="preferenceTheme">@style/HsPreferenceTheme</item>
+        <item name="alertDialogTheme">@style/HsDialog</item>
+        <item name="android:alertDialogTheme">@style/HsDialog</item>
+        <item name="colorControlNormal">@color/hs_ink</item>
+        <item name="colorControlActivated">@color/hs_ink</item>
+        <item name="android:textColorPrimary">@color/hs_ink</item>
+        <item name="android:textColorSecondary">@color/hs_grey</item>
+        <item name="android:defaultFocusHighlightEnabled">false</item>
+    </style>
+
+    <style name="HsActionBar" parent="Widget.AppCompat.Light.ActionBar.Solid">
+        <item name="background">@drawable/hs_title_bar</item>
+        <item name="android:background">@drawable/hs_title_bar</item>
+        <item name="elevation">0dp</item>
+        <item name="titleTextStyle">@style/HsTitleText</item>
+    </style>
+
+    <style name="HsTitleText" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
+        <item name="android:textSize">21sp</item>
+        <item name="android:textColor">@color/hs_ink</item>
+        <item name="android:fontFamily">sans-serif-medium</item>
+    </style>
+
+    <style name="HsPreferenceTheme" parent="PreferenceThemeOverlay">
+        <item name="preferenceStyle">@style/HsPreference</item>
+        <item name="preferenceCategoryStyle">@style/HsCategory</item>
+        <item name="switchPreferenceCompatStyle">@style/HsSwitchPreference</item>
+        <item name="dialogPreferenceStyle">@style/HsDialogPreference</item>
+        <item name="seekBarPreferenceStyle">@style/HsSeekBarPreference</item>
+    </style>
+
+    <!-- Rows draw a hairline between each other; section labels carry their own black rule instead. -->
+    <style name="HsPreference" parent="Preference.Material">
+        <item name="android:layout">@layout/hs_preference</item>
+        <item name="allowDividerAbove">true</item>
+        <item name="allowDividerBelow">true</item>
+    </style>
+
+    <style name="HsCategory" parent="Preference.Category.Material">
+        <item name="android:layout">@layout/hs_category</item>
+        <item name="allowDividerAbove">false</item>
+        <item name="allowDividerBelow">false</item>
+    </style>
+
+    <style name="HsSeekBarPreference" parent="Preference.SeekBarPreference.Material">
+        <item name="android:layout">@layout/hs_seekbar</item>
+        <item name="allowDividerAbove">true</item>
+        <item name="allowDividerBelow">true</item>
+    </style>
+
+    <style name="HsSwitchPreference" parent="Preference.SwitchPreferenceCompat.Material">
+        <item name="android:layout">@layout/hs_preference</item>
+        <item name="android:widgetLayout">@layout/hs_switch</item>
+        <item name="allowDividerAbove">true</item>
+        <item name="allowDividerBelow">true</item>
+    </style>
+
+    <style name="HsDialogPreference" parent="Preference.DialogPreference.Material">
+        <item name="android:layout">@layout/hs_preference</item>
+        <item name="allowDividerAbove">true</item>
+        <item name="allowDividerBelow">true</item>
+    </style>
+
+    <style name="HsDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
+        <item name="android:windowBackground">@drawable/hs_dialog_bg</item>
+        <item name="android:backgroundDimEnabled">false</item>
+        <item name="android:windowElevation">0dp</item>
+        <item name="colorAccent">@color/hs_ink</item>
+        <item name="colorControlNormal">@color/hs_ink</item>
+        <item name="colorControlActivated">@color/hs_ink</item>
+        <item name="android:textColorPrimary">@color/hs_ink</item>
+        <item name="android:textColorAlertDialogListItem">@color/hs_ink</item>
+        <item name="buttonBarButtonStyle">@style/HsDialogButton</item>
+    </style>
+
+    <style name="HsDialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
+        <item name="android:textAllCaps">false</item>
+        <item name="android:textSize">16sp</item>
+        <item name="android:textColor">@color/hs_ink</item>
+    </style>
+
     <style name="MenuButtonStyle" parent="Widget.AppCompat.Button.Borderless">
         <item name="android:textSize">12sp</item>
         <item name="android:background">@drawable/drawable_border_normal</item>
