+// Map an output-space rectangle through the layer's display frame, source crop and
+// buffer transform. The XRZ composer consumes damage in buffer coordinates.
+Rect outputToBufferBounds(const Rect& r, const Rect& frame, const FloatRect& crop,
+                          uint32_t transform) {
+    if (frame.isEmpty() || crop.isEmpty()) {
+        return Rect::INVALID_RECT;
+    }
+    const float width = static_cast<float>(frame.getWidth());
+    const float height = static_cast<float>(frame.getHeight());
+    const auto toSource = [transform](float u, float v) {
+        if (transform & HAL_TRANSFORM_ROT_90) {
+            const float x = v;
+            v = 1.f - u;
+            u = x;
+        }
+        if (transform & HAL_TRANSFORM_FLIP_V) {
+            v = 1.f - v;
+        }
+        if (transform & HAL_TRANSFORM_FLIP_H) {
+            u = 1.f - u;
+        }
+        return std::pair{u, v};
+    };
+    const auto [u0, v0] = toSource(static_cast<float>(r.left - frame.left) / width,
+                                   static_cast<float>(r.top - frame.top) / height);
+    const auto [u1, v1] = toSource(static_cast<float>(r.right - frame.left) / width,
+                                   static_cast<float>(r.bottom - frame.top) / height);
+    return Rect(static_cast<int32_t>(std::floor(crop.left + std::min(u0, u1) * crop.getWidth())),
+                static_cast<int32_t>(std::floor(crop.top + std::min(v0, v1) * crop.getHeight())),
+                static_cast<int32_t>(std::ceil(crop.left + std::max(u0, u1) * crop.getWidth())),
+                static_cast<int32_t>(std::ceil(crop.top + std::max(v0, v1) * crop.getHeight())));
+}
+
 std::shared_ptr<gui::DisplayLuts> createLutsFromAgtm(
         const OutputCompositionState& outputState, const sp<GraphicBuffer>& buffer,
         const std::vector<std::optional<LutProperties>>& properties, ui::Dataspace dataspace) {
@@ -981,6 +1020,46 @@ void OutputLayer::writeOutputIndependentPerFrameStateToHWC(
         }
     }
 
+    // With forced client composition, changes from removed/moved layers may leave
+    // unchanged layers with empty buffer damage. Damage their exposed portions so
+    // the XRZ composer does not treat the frame as unchanged.
+    const auto& outputState = getOutput().getState();
+    if (surfaceDamage.isEmpty() && !outputState.einkCompositionDirty.isEmpty() &&
+        outputState.einkCompositionDirty.getBounds() != Rect::INVALID_RECT &&
+        outputIndependentState.buffer && !getState().overrideInfo.buffer) {
+        const Region exposed =
+                outputState.einkCompositionDirty.intersect(getState().visibleRegion);
+        const Rect bufferBounds(outputIndependentState.buffer->getWidth(),
+                                outputIndependentState.buffer->getHeight());
+        for (const Rect& rect : exposed) {
+            Rect inFrame;
+            if (!outputState.transform.transform(rect).intersect(getState().displayFrame,
+                                                                  &inFrame)) {
+                continue;
+            }
+            const Rect mapped = outputToBufferBounds(
+                    inFrame, getState().displayFrame, getState().sourceCrop,
+                    static_cast<uint32_t>(getState().bufferTransform));
+            Rect inBuffer;
+            surfaceDamage.orSelf(mapped.intersect(bufferBounds, &inBuffer) ? inBuffer
+                                                                            : bufferBounds);
+        }
+        if (!surfaceDamage.isEmpty()) {
+            static std::atomic<nsecs_t> lastLog{0};
+            static std::atomic_int count{0};
+            const int sent = count.fetch_add(1) + 1;
+            const nsecs_t now = systemTime();
+            if (now - lastLog.load() >= s2ns(5)) {
+                lastLog.store(now);
+                count.store(0);
+                const Rect bounds = surfaceDamage.getBounds();
+                ALOGI("EinkDamage: composition-only damage [%s] %d,%d,%d,%d (%d since last log)",
+                      getLayerFE().getDebugName(), bounds.left, bounds.top, bounds.right,
+                      bounds.bottom, sent);
+            }
+        }
+    }
+
     if (auto error = hwcLayer->setSurfaceDamage(surfaceDamage); error != hal::Error::NONE) {
         ALOGE("[%s] Failed to set surface damage: %s (%d)", getLayerFE().getDebugName(),
               to_string(error).c_str(), static_cast<int32_t>(error));
