diff --git a/controller/a9_accessibility_service/res/layout/hs_preference.xml b/controller/a9_accessibility_service/res/layout/hs_preference.xml
new file mode 100644
index 0000000..50924e6
--- /dev/null
+++ b/controller/a9_accessibility_service/res/layout/hs_preference.xml
@@ -0,0 +1,48 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- One settings row in the Hisense e-ink layout: title, grey summary, control on the right. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:minHeight="64dp"
+    android:gravity="center_vertical"
+    android:orientation="horizontal"
+    android:paddingStart="24dp"
+    android:paddingEnd="20dp"
+    android:paddingTop="10dp"
+    android:paddingBottom="10dp"
+    android:background="@android:color/white"
+    android:defaultFocusHighlightEnabled="false">
+    <ImageView
+        android:id="@android:id/icon"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        android:visibility="gone" />
+    <LinearLayout
+        android:layout_width="0dp"
+        android:layout_height="wrap_content"
+        android:layout_weight="1"
+        android:orientation="vertical">
+        <TextView
+            android:id="@android:id/title"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:textSize="16sp"
+            android:textColor="@color/hs_ink" />
+        <TextView
+            android:id="@android:id/summary"
+            android:layout_width="match_parent"
+            android:layout_height="wrap_content"
+            android:layout_marginTop="4dp"
+            android:lineSpacingMultiplier="1.1"
+            android:maxLines="6"
+            android:textSize="13sp"
+            android:textColor="@color/hs_grey" />
+    </LinearLayout>
+    <LinearLayout
+        android:id="@android:id/widget_frame"
+        android:layout_width="wrap_content"
+        android:layout_height="wrap_content"
+        android:layout_marginStart="14dp"
+        android:gravity="center_vertical|end"
+        android:orientation="horizontal" />
+</LinearLayout>
diff --git a/controller/a9_accessibility_service/res/layout/hs_seekbar.xml b/controller/a9_accessibility_service/res/layout/hs_seekbar.xml
new file mode 100644
index 0000000..7abaa3c
--- /dev/null
+++ b/controller/a9_accessibility_service/res/layout/hs_seekbar.xml
@@ -0,0 +1,55 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Slider row in the Hisense layout: title and grey summary, then the slider with its value on the right. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+    android:layout_width="match_parent"
+    android:layout_height="wrap_content"
+    android:orientation="vertical"
+    android:paddingStart="24dp"
+    android:paddingEnd="20dp"
+    android:paddingTop="12dp"
+    android:paddingBottom="8dp"
+    android:background="@android:color/white"
+    android:clipChildren="false"
+    android:defaultFocusHighlightEnabled="false">
+    <ImageView
+        android:id="@android:id/icon"
+        android:layout_width="0dp"
+        android:layout_height="0dp"
+        android:visibility="gone" />
+    <TextView
+        android:id="@android:id/title"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:textSize="16sp"
+        android:textColor="@color/hs_ink" />
+    <TextView
+        android:id="@android:id/summary"
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="4dp"
+        android:lineSpacingMultiplier="1.1"
+        android:textSize="13sp"
+        android:textColor="@color/hs_grey" />
+    <LinearLayout
+        android:layout_width="match_parent"
+        android:layout_height="wrap_content"
+        android:layout_marginTop="6dp"
+        android:gravity="center_vertical"
+        android:clipChildren="false"
+        android:orientation="horizontal">
+        <SeekBar
+            android:id="@+id/seekbar"
+            android:layout_width="0dp"
+            android:layout_height="40dp"
+            android:layout_weight="1"
+            android:background="@null"
+            android:defaultFocusHighlightEnabled="false" />
+        <TextView
+            android:id="@+id/seekbar_value"
+            android:layout_width="44dp"
+            android:layout_height="wrap_content"
+            android:gravity="end"
+            android:textSize="15sp"
+            android:textColor="@color/hs_ink" />
+    </LinearLayout>
+</LinearLayout>
