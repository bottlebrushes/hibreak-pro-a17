+package com.lmqr.ha9_comp_service.button_mapper
+
+import android.content.Context
+import android.content.Intent
+
+/** Turns the page of the e-ink shade's reading lock screen (+1 next, -1 previous); does nothing for other styles. */
+class LockPageButtonAction(private val delta: Int) : ButtonAction {
+    override fun execute(context: Context) {
+        context.sendBroadcast(Intent("local.eink.shade.LOCK_PAGE").setPackage("local.eink.shade").putExtra("d", delta))
+    }
+}
