<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar widget: today's date, then as many of the next events as fit (day/time and title). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="8dp"
    android:background="@drawable/w_bg">
    <TextView android:id="@+id/c_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Wednesday, November 11"
        android:textSize="16sp" android:textColor="#FF1E1E1E" android:fontFamily="sans-serif-medium" android:maxLines="1" />
    <!-- rule under the date (plain View is not allowed in widgets) -->
    <FrameLayout android:layout_width="match_parent" android:layout_height="1.5dp" android:layout_marginTop="6dp" android:background="#FF1E1E1E" />
    <TextView android:id="@+id/c_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:textSize="15sp" android:textColor="#FF1E1E1E" android:visibility="gone" />
    <LinearLayout android:id="@+id/c_e0" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/c_e0_time" android:text="All day" android:layout_width="86dp" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" />
        <TextView android:id="@+id/c_e0_title" android:text="Veterans Day" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/c_e1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/c_e1_time" android:text="3:00 PM" android:layout_width="86dp" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" />
        <TextView android:id="@+id/c_e1_title" android:text="Do Duolingo!" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/c_e2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal">
        <TextView android:id="@+id/c_e2_time" android:text="10:15 PM" android:layout_width="86dp" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" />
        <TextView android:id="@+id/c_e2_title" android:text="Meetup" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/c_e3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/c_e3_time" android:layout_width="86dp" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" />
        <TextView android:id="@+id/c_e3_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/c_e4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:orientation="horizontal" android:visibility="gone">
        <TextView android:id="@+id/c_e4_time" android:layout_width="86dp" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" />
        <TextView android:id="@+id/c_e4_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="15sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
