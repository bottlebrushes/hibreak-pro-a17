+/** Extra rows for the per-app e-ink menu: light presets and a per-app "Invert colors" switch. */
+object MenuExtras {
+    private const val TAG_INVERT = "extras_invert"
+    private var updating = false
+    private val PRESETS = listOf("day" to "Day", "reading" to "Read", "evening" to "Evening", "bedtime" to "Bedtime", "off" to "Off")
+
+    private fun dp(c: Context, v: Float) = TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v, c.resources.displayMetrics).toInt()
+
+    fun attach(c: Context, menu: FloatingMenuViewAccessor, brightness: BrightnessManager, prefs: SharedPreferences,
+               currentPkg: () -> String, applyInvert: (String) -> Unit) {
+        val root = menu.root as? ViewGroup ?: return
+        val anchor = root.findViewById<View>(R.id.use_default_contrast)
+        var index = root.indexOfChild(anchor).takeIf { it >= 0 } ?: root.childCount
+
+        val title = TextView(c).apply {
+            text = "Light presets"; setTextColor(Color.BLACK); textSize = 15f; gravity = Gravity.CENTER
+            setPadding(0, dp(c, 8f), 0, dp(c, 4f))
+        }
+        root.addView(title, index++)
+        val row = LinearLayout(c).apply { orientation = LinearLayout.HORIZONTAL; setPadding(dp(c, 4f), 0, dp(c, 4f), dp(c, 4f)) }
+        for ((id, label) in PRESETS) {
+            val b = TextView(c).apply {
+                text = label; setTextColor(Color.BLACK); textSize = 14f; gravity = Gravity.CENTER
+                background = GradientDrawable().apply { cornerRadius = dp(c, 14f).toFloat(); setStroke(dp(c, 1.5f), Color.BLACK); setColor(Color.WHITE) }
+                setPadding(0, dp(c, 9f), 0, dp(c, 9f))
+                setOnClickListener { brightness.applyPreset(id) }
+            }
+            row.addView(b, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f).apply { setMargins(dp(c, 3f), 0, dp(c, 3f), 0) })
+        }
+        root.addView(row, index++)
+
+        val inv = Switch(c).apply {
+            tag = TAG_INVERT; text = "Invert colors (this app)"; setTextColor(Color.BLACK)
+            thumbTintList = android.content.res.ColorStateList.valueOf(Color.BLACK)
+            minHeight = dp(c, 48f)
+        }
+        root.addView(inv, index, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        inv.setOnCheckedChangeListener { _, on ->
+            if (updating) return@setOnCheckedChangeListener
+            val pkg = currentPkg()
+            if (pkg.isEmpty()) return@setOnCheckedChangeListener
+            prefs.edit().putBoolean("invert:$pkg", on).apply()
+            applyInvert(pkg)
+        }
+        refresh(menu, prefs, currentPkg())
+    }
+
+    fun refresh(menu: FloatingMenuViewAccessor, prefs: SharedPreferences, pkg: String) {
+        val inv = menu.root.findViewWithTag<Switch>(TAG_INVERT) ?: return
+        updating = true
+        inv.isChecked = prefs.getBoolean("invert:$pkg", false)
+        updating = false
+    }
+}
