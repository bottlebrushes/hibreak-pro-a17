From 9dab768ffe53521c58413ffd3750fa6248ff8e5e Mon Sep 17 00:00:00 2001
From: HiBreak Pro A17 <hibreak-pro-a17@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:44:43 +0100
Subject: [PATCH 3/6] device: preserve forced client composition for Bigme XRZ

---
 services/surfaceflinger/SurfaceFlinger.cpp | 10 +++++++++-
 1 file changed, 9 insertions(+), 1 deletion(-)

diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 759b590..d0efd23 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -505,6 +505,10 @@ SurfaceFlinger::SurfaceFlinger(Factory& factory) : SurfaceFlinger(factory, SkipI
     SFTRACE_CALL();
     ALOGI("SurfaceFlinger is starting");
 
+    // Legacy XRZ composers need the complete frame flattened into the client target.
+    mDebugDisableHWC = base::GetBoolProperty("ro.bigme.force_client_composition", false);
+    ALOGI_IF(mDebugDisableHWC, "BIGME_DISPLAY: forcing client composition");
+
     hasSyncFramework = running_without_sync_framework(true);
 
     dispSyncPresentTimeOffset = present_time_offset_from_vsync_ns(0);
@@ -9979,7 +9983,11 @@ void SurfaceFlinger::sfdo_scheduleCommit() {
 }
 
 void SurfaceFlinger::sfdo_forceClientComposition(bool enabled) {
-    mDebugDisableHWC = enabled;
+    const bool required = base::GetBoolProperty("ro.bigme.force_client_composition", false);
+    ALOGI_IF(required && !enabled,
+             "BIGME_DISPLAY: preserving client composition (caller pid=%d uid=%d)",
+             IPCThreadState::self()->getCallingPid(), IPCThreadState::self()->getCallingUid());
+    mDebugDisableHWC = enabled || required;
     scheduleRepaint();
 }
 
