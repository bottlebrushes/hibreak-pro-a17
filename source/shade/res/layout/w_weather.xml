<?xml version="1.0" encoding="utf-8"?>
<!-- Weather widget: now (symbol, temperature, condition, high/low, place) over the next four days. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="8dp"
    android:background="@drawable/w_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_icon" android:layout_width="44dp" android:layout_height="44dp" />
        <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:textSize="36sp" android:textColor="#FF1E1E1E"
            android:fontFamily="sans-serif-light" android:includeFontPadding="false" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/w_cond" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="16sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_hilo" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" />
            <TextView android:id="@+id/w_place" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/w_days" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_d0_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
            <ImageView android:id="@+id/w_d0_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="1dp" />
            <TextView android:id="@+id/w_d0_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_d1_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
            <ImageView android:id="@+id/w_d1_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="1dp" />
            <TextView android:id="@+id/w_d1_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_d2_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
            <ImageView android:id="@+id/w_d2_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="1dp" />
            <TextView android:id="@+id/w_d2_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center_horizontal">
            <TextView android:id="@+id/w_d3_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
            <ImageView android:id="@+id/w_d3_icon" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginTop="1dp" />
            <TextView android:id="@+id/w_d3_temp" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#FF1E1E1E" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
