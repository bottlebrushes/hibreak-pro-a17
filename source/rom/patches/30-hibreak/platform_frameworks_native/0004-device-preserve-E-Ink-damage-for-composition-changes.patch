 }
+// The XRZ composer can skip a commit when forced client composition has no layer
+// damage. Keep this opt-in to physical Bigme outputs and provide a runtime kill switch.
+bool einkCompositionDamageEnabled() {
+    static const bool forced =
+            base::GetBoolProperty("ro.bigme.force_client_composition", false);
+    if (!forced) {
+        return false;
+    }
+    static base::CachedBoolProperty enabled("persist.debug.hibreak.composition_damage");
+    return enabled.Get(true);
+}
 
 } // namespace
 
+
