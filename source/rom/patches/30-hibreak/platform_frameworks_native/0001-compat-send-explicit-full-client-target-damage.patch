From fcf81e8ccfc8a12004c86ea2579079c6f99ac410 Mon Sep 17 00:00:00 2001
From: HiBreak Pro A17 <hibreak-pro-a17@users.noreply.github.com>
Date: Sat, 14 Nov 2026 05:43:46 +0100
Subject: [PATCH 1/6] compat: send explicit full client-target damage

---
 .../DisplayHardware/FramebufferSurface.cpp           |  5 +++--
 services/surfaceflinger/DisplayHardware/HWC2.cpp     | 12 ++++++++----
 services/surfaceflinger/DisplayHardware/HWC2.h       |  5 +++--
 .../surfaceflinger/DisplayHardware/HWComposer.cpp    |  7 +++++--
 services/surfaceflinger/DisplayHardware/HWComposer.h |  4 ++--
 .../DisplayHardware/LegacyFramebufferSurface.cpp     |  5 +++--
 .../VirtualDisplay/LegacyVirtualDisplaySurface.cpp   |  6 ++++--
 .../VirtualDisplay/VirtualDisplaySurface.cpp         |  3 ++-
 .../tests/unittests/FramebufferSurfaceTest.cpp       | 10 +++++-----
 .../tests/unittests/VirtualDisplaySurfaceTest.cpp    |  4 ++--
 .../tests/unittests/mock/DisplayHardware/MockHWC2.h  |  2 +-
 .../unittests/mock/DisplayHardware/MockHWComposer.h  |  2 +-
 12 files changed, 39 insertions(+), 26 deletions(-)

diff --git a/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp b/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
index f21b964..15de4f6 100644
--- a/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
+++ b/services/surfaceflinger/DisplayHardware/FramebufferSurface.cpp
@@ -117,8 +117,9 @@ status_t FramebufferSurface::advanceFrame(float hdrSdrRatio) {
     auto [requiresRefresh, hwcSlot] = mHwcSlotTracker.getSlot(mFrameData->mBuffer);
     sp<GraphicBuffer> hwcBuffer = requiresRefresh ? mFrameData->mBuffer : nullptr;
 
-    status_t result = mHwc.setClientTarget(mDisplayId, hwcSlot, mFrameData->mFence, hwcBuffer,
-                                           mDataspace, hdrSdrRatio);
+    status_t result = mHwc.setClientTarget(
+            mDisplayId, hwcSlot, mFrameData->mFence, hwcBuffer, mDataspace, hdrSdrRatio,
+            ui::Size(mFrameData->mBuffer->getWidth(), mFrameData->mBuffer->getHeight()));
     if (result != NO_ERROR) {
         ALOGE("error posting framebuffer: %s (%d)", strerror(-result), result);
         return result;
diff --git a/services/surfaceflinger/DisplayHardware/HWC2.cpp b/services/surfaceflinger/DisplayHardware/HWC2.cpp
index 0b22f3f..5038c83 100644
--- a/services/surfaceflinger/DisplayHardware/HWC2.cpp
+++ b/services/surfaceflinger/DisplayHardware/HWC2.cpp
@@ -461,12 +461,16 @@ Error Display::setActiveConfigWithConstraints(hal::HWConfigId configId,
 
 Error Display::setClientTarget(uint32_t slot, const sp<GraphicBuffer>& target,
                                const sp<Fence>& acquireFence, Dataspace dataspace,
-                               float hdrSdrRatio) {
-    // TODO: Properly encode client target surface damage
+                               float hdrSdrRatio, ui::Size bufferSize) {
+    // Some legacy composers treat an empty damage list as unchanged rather than full damage.
+    // Send explicit client-target bounds, including when the buffer handle is cached.
+    std::vector<Hwc2::IComposerClient::Rect> damage;
+    if (bufferSize.width > 0 && bufferSize.height > 0) {
+        damage.push_back({0, 0, bufferSize.width, bufferSize.height});
+    }
     int32_t fenceFd = acquireFence->dup();
     auto intError =
-            mComposer.setClientTarget(mId, slot, target, fenceFd, dataspace,
-                                      std::vector<Hwc2::IComposerClient::Rect>(), hdrSdrRatio);
+            mComposer.setClientTarget(mId, slot, target, fenceFd, dataspace, damage, hdrSdrRatio);
     return static_cast<Error>(intError);
 }
 
diff --git a/services/surfaceflinger/DisplayHardware/HWC2.h b/services/surfaceflinger/DisplayHardware/HWC2.h
index c93ef9b..f50a9e1 100644
